# ==============================================================================
# INVENTORYNET - DOCKER COMPOSE ENVIRONMENT CONFIGURATION
# Salin file ini menjadi `.env` jika Anda ingin menyesuaikan port host
# agar tidak terjadi bentrok dengan project lain di VPS atau komputer lokal Anda.
# ==============================================================================

# Port Frontend (Next.js) di Host (Default: 3000)
FRONTEND_PORT=3000

# Port Backend (.NET 8) di Host (Default: 8080)
BACKEND_PORT=8080

# Port Oracle Database di Host (Default: 1521)
ORACLE_PORT=1521

# Port Redis di Host (Hanya diaktifkan jika baris ports di docker-compose di-uncomment, default internal saja)
REDIS_PORT=6385
