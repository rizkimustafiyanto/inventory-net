# ==============================================================================
# INVENTORYNET - PRODUCTION FRONTEND ENVIRONMENT
# Copy isi file ini ke GitHub Environment Secret: FRONTEND_ENV (Environment: production)
# ==============================================================================

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# URL Domain Anda (karena Nginx me-reverse proxy /api/ ke backend, cukup isi domain utama Anda)
# Contoh: https://inventory.namadomain.com (atau https://inventory.namadomain.com:8080 jika port langsung)
NEXT_PUBLIC_API_BASE_URL=https://inventory.namadomain.com
